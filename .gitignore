# Visual Studio hidden folder (cache, indexes, user settings)
.vs/
*.user
*.userossc
*.sln.docstates

# Build outputs and temporary execution binaries
[Bb]in/
[Oo]bj/
[LLEe]og/
[Ll]ogs/

# User-specific files
*.rsuser
*.suo
*.user
*.userquery

# NuGet Packages directory
*.nupkg
