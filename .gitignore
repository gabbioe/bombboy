!**/packages/build/

# Microsoft HTTP / API test files containing secrets
*.env
*.env.local
appsettings.Development.json

# Test results and coverage reports
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml

# Publish outputs
**/publish/

# Rider / JetBrains IDE files (if anyone on your team uses Rider)
.idea/
*.sln.iml
